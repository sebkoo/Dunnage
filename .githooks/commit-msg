#!/bin/sh
# Commit messages carry no automated tool-attribution trailers.
# Human trailers (Co-authored-by:, Signed-off-by:) are preserved.
# What counts as prohibited is defined once, in attribution.awk.
set -e
msg="$1"
[ -f "$msg" ] || exit 0

here=$(unset CDPATH; cd -- "$(dirname -- "$0")" && pwd -P)
filter="$here/attribution.awk"
if [ ! -f "$filter" ]; then
  echo "commit-msg: $filter missing; message not sanitized." >&2
  exit 0                      # sanitize is best-effort; the audit is what detects
fi

tmp="$msg.policy.$$"
trap 'rm -f "$tmp" "$tmp.2"' EXIT

LC_ALL=C awk -f "$filter" -v mode=strip "$msg" > "$tmp"

# Removing a trailer block can leave trailing blank lines behind.
LC_ALL=C awk '
  { buf[NR] = $0 }
  END { last = 0
        for (i = 1; i <= NR; i++) if (buf[i] ~ /[^ \t]/) last = i
        for (i = 1; i <= last; i++) print buf[i] }
' "$tmp" > "$tmp.2"

cmp -s "$msg" "$tmp.2" || cat "$tmp.2" > "$msg"
exit 0
